        <mxCell id="nKA0zrrdCLjoVEnoJHJr-176" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#10739e;fillColor=#b1ddf0;align=center;verticalAlign=middle;rounded=0;" value="Install Directory" vertex="1">
