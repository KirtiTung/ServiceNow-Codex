        <mxCell id="nKA0zrrdCLjoVEnoJHJr-177" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#10739e;fillColor=#b1ddf0;align=center;verticalAlign=middle;rounded=0;" value="TCP Port" vertex="1">
          <mxGeometry height="30" width="103" x="2284" y="3941" as="geometry" />
        </mxCell>
        <mxCell id="nKA0zrrdCLjoVEnoJHJr-178" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#10739e;fillColor=#b1ddf0;align=center;verticalAlign=middle;rounded=0;" value="TCP Port" vertex="1">
          <mxGeometry height="30" width="103" x="2392" y="3941" as="geometry" />
        </mxCell>
        <mxCell id="nKA0zrrdCLjoVEnoJHJr-179" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#10739e;fillColor=#b1ddf0;align=center;verticalAlign=middle;rounded=0;" value="Install Directory" vertex="1">
