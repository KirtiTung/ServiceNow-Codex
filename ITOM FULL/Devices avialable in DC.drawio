        <mxCell id="FwvzGLWBU-6Ovo8N_6BO-114" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;table class=&quot;NRefec&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 14px; margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;&lt;tbody style=&quot;margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;&lt;tr class=&quot;cZCYO&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;&lt;th class=&quot;iry6k&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;Feature&lt;/th&gt;&lt;th class=&quot;iry6k&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;TCP (Transmission Control Protocol)&lt;/th&gt;&lt;th class=&quot;iry6k&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;UDP (User Datagram Protocol)&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;cZCYO&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;Connection Type&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;Connection-oriented&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;margin: 0px; border-bottom: 1px solid rgb(54, 56, 64);&quot; colspan=&quot;undefined&quot;&gt;Connectionless&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;cZCYO&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(230, 232, 240);&quot;&gt;&lt;td class=&quot;Vk1l